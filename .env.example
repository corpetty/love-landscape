# ─── Supabase (frontend build — expose via Vite) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase (backend API functions only — NOT exposed to browser) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── OpenRouter (backend API functions only) ─────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# Model overrides (optional — defaults shown)
# MANAGED_MODEL_FAST=anthropic/claude-haiku-4-5        # param adjustment (fast/cheap)
# MANAGED_MODEL_QUALITY=anthropic/claude-sonnet-4-5    # narrative + pair readings

# Free credits per new anonymous session (optional, default: 5)
# FREE_CREDITS=5

# ─── Stripe (backend API functions only) ─────────────────────────────────────
# 1. Create a product + price at https://dashboard.stripe.com/products
# 2. Add https://love-landscape.com/api/webhook as a webhook endpoint
#    for the event: checkout.session.completed
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_CREDITS_PER_PACK=20

# One-time reading SKUs. Each stays DORMANT — the offer is not rendered at all —
# until BOTH its Stripe price and its VITE_ price label are set, so a half-wired
# product can never take money it cannot deliver on.
#   Full Reading      — STRIPE_PRICE_FULL_READING
#   Compatibility     — STRIPE_PRICE_COMPATIBILITY + VITE_COMPATIBILITY_PRICE (migration 007)
#   Journey Reading   — STRIPE_PRICE_JOURNEY      + VITE_JOURNEY_PRICE      (migration 010)
STRIPE_PRICE_FULL_READING=price_...
STRIPE_PRICE_COMPATIBILITY=price_...
STRIPE_PRICE_JOURNEY=price_...

# The price label shown on the button, without a currency symbol (e.g. "8").
VITE_COMPATIBILITY_PRICE=
VITE_JOURNEY_PRICE=

# ─── App public URL (for Stripe redirect after payment) ───────────────────────
VITE_PUBLIC_URL=https://love-landscape.com
